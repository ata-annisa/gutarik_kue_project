    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "prisma": "7.10.1"
  }
}
